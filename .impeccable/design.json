  "narrative": {
    "northStar":"墨色书页",
    "overview":"用深墨色与灰绿层次给对话留出安静的阅读空间。视觉表达来自清晰的排版、稳定的间距和明确的状态，而非装饰性效果。沿用熟悉的通讯界面，让消息、会话与下一步操作容易辨认。\n\n默认深色是用户确认的产品要求；同一套组件也必须适配用户自定义的背景、面板和强调色。现有 LinChat 名称与图标保留。",
    "keyCharacteristics":["深墨画布与略亮面板区分工作区域。","强调色用于主操作、选中状态和必要提示。","系统字体、细完整边框与克制圆角。","配色预览与实际界面共享同一套计算逻辑。"],
    "rules":[
      {"name":"The Independent Surface Rule","body":"Canvas, panel and navigation each derive their own text, muted, border, focus, selected and semantic colors. A light panel on a dark canvas is valid; do not assume that all regions share one foreground.","section":"colors"},
      {"name":"The Semantic Color Rule","body":"Amber identifies private material, mentions and paused/pending states; red identifies errors; the online marker uses a separately adapted success color. User accent changes do not replace these meanings.","section":"colors"},
      {"name":"The Reading Priority Rule","body":"Keep message prose larger and more open than timestamps, receipts and navigation metadata.","section":"typography"}
    ],
    "dos":["Do use derived semantic variables for every new surface and state.","Do keep primary actions reachable while message or settings content scrolls.","Do preserve readable Chinese body copy and the current responsive navigation.","Do preview custom colors with the same runtime used by the application."],
    "donts":["Don't hard-code a light panel or dark foreground inside a themed component.","Don't use the user accent to replace error, private or connection semantics.","Don't add ornamental gradients, glow, large promotional labels or entrance animations to the workspace.","Don't interpret a dark default as a restriction on user-selected colors."]
  }
}
