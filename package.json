{
  "name": "linchat-desktop",
  "version": "1.2.11",
  "description": "LinChat — 云端与 Radmin 虚拟局域网兼容的多人实时通讯",
  "author": "LinChat",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "icons": "node scripts/icons.cjs",
    "build:web": "npm --prefix web run build",
    "build:server": "node scripts/build-server.cjs",
    "build": "npm run icons && npm run build:web && npm run build:server",
    "dev": "electron .",
    "package": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "package:dir": "npm run build && electron-builder --win --dir",
    "test:desktop": "electron scripts/desktop-smoke.cjs",
    "test:auto-update": "node scripts/auto-update-check.cjs",
    "test:features": "node --test scripts/mentions.test.cjs scripts/updates.test.cjs scripts/campaign.test.cjs",
    "test:entertainment": "node scripts/entertainment-check.cjs",
    "test:dice": "node scripts/dice-check.cjs",
    "test:streaming": "node --test scripts/model-stream.test.cjs && node scripts/streaming-check.cjs",
    "test:realtime": "node scripts/realtime-check.cjs",
    "test:lore": "node scripts/lore-check.cjs",
    "test:memory": "node scripts/memory-check.cjs",
    "test:appearance": "node --test scripts/theme.test.cjs",
    "test:window-state": "node --test scripts/window-state.test.cjs && node scripts/window-state-check.cjs",
    "test:titlebar": "node scripts/titlebar-check.cjs",
    "test:window-position": "node scripts/window-position-check.cjs",
    "test:quick-replies": "node scripts/quick-replies-check.cjs",
    "test:reading-position": "node scripts/reading-position-check.cjs",
    "test:ability-checks": "node scripts/ability-checks-check.cjs",
    "campaign:mcp": "node scripts/campaign-mcp.cjs",
    "campaign:agent": "node scripts/campaign-agent.cjs",
    "release:manifest": "node scripts/release-manifest.cjs",
    "release:publish": "node scripts/publish-release.cjs"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0",
    "playwright-core": "^1.65.1",
    "undici": "^8.13.1"
  },
  "build": {
    "appId": "site.linblog.linchat",
    "productName": "LinChat",
    "publish": [
      { "provider": "github", "owner": "Lin-6499", "repo": "ChatForPlay" }
    ],
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist/desktop/${version}",
      "buildResources": "desktop/build-resources"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/server/linchat-windows-amd64.exe",
        "to": "server/linchat-server.exe"
      }
    ],
    "asar": true,
    "win": {
      "icon": "desktop/assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "selectPerMachineByDefault": false,
      "allowElevation": false,
      "include": "desktop/installer.nsh",
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LinChat",
      "artifactName": "LinChat-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "LinChat-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
